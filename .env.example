APP_NAME=omni-chan
APP_ENV=development

HTTP_HOST=0.0.0.0
HTTP_PORT=8080

DATABASE_URL=postgres://postgres:postgres@localhost:5432/omni_chan?sslmode=disable
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5

REDIS_URL=redis://localhost:6379/0

STORAGE_SERVICE_URL=http://127.0.0.1:8082
# Public webhook-service base Meta can fetch. Main Backend and Storage stay internal.
WEBHOOK_PUBLIC_BASE_URL=https://webhook.example.com
MEDIA_TOKEN_SECRET=change-me-media-token-secret
MEDIA_TOKEN_TTL=5m

JWT_ACCESS_SECRET=dev-access-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Meta App ID from Developer Console > App Settings > Basic
META_APP_ID=
# App Secret from Meta Developer Console > App Settings > Basic (NOT the WhatsApp access token).
META_APP_SECRET=
# Embedded Signup configuration ID (Facebook Login for Business > Configurations)
META_EMBEDDED_CONFIG_ID=
META_VERIFY_TOKEN=dev-meta-verify-token
META_API_VERSION=v21.0
# Base64-encoded 32-byte AES key for encrypting channel access tokens at rest
META_TOKEN_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Optional payment setup URL template. Placeholders: {business_id}, {waba_id}, {phone_number_id}
META_PAYMENT_SETUP_URL=
# Instagram Business API credentials (Instagram Login — separate from WhatsApp Embedded Signup)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must match Meta App → Instagram → Business login → OAuth redirect URI (backend callback)
INSTAGRAM_REDIRECT_URI=https://signup.omnichan.id/api/v1/channels/instagram/callback

# NATS event consumer (webhook-service publishes, backend consumes)
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=WEBHOOK_EVENTS
NATS_CONSUMER_ENABLED=true
NATS_CONSUMER_NAME=backend-service
INTERNAL_SERVICE_TOKEN=dev-internal-token

# Public OTP login — device slug (set on devices.slug column, e.g. UPDATE devices SET slug = 'dgos-waba' WHERE ...)
OTP_DEFAULT_DEVICE_SLUG=dgos-waba
# POST /api/v1/otp/send requires body field "token" matching META_VERIFY_TOKEN (rate-limit / abuse guard).
